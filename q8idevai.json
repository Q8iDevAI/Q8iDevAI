{
  "worktree": {
    "setup": [
      "npm ci",
      "node ./scripts/seed-ios-native-cache.mjs",
      "node ./scripts/seed-worktree-dev-state.mjs",
      "npm run build:server",
      "npm run build --workspace=@q8idevai/expo-two-way-audio"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "Q8IDEVAI_DEV_MANAGED_HOME=1 Q8IDEVAI_DEV_ROOT=\"${Q8IDEVAI_WORKTREE_PATH:-$PWD}\" Q8IDEVAI_HOME=\"${Q8IDEVAI_WORKTREE_PATH:-$PWD}/.dev/q8idevai-home\" Q8IDEVAI_SKIP_DEV_SERVER_BUILD=1 Q8IDEVAI_LISTEN=0.0.0.0:${Q8IDEVAI_PORT:-6768} ./scripts/dev-daemon.sh"
    },
    "app": {
      "type": "service",
      "command": "Q8IDEVAI_DEV_MANAGED_HOME=1 Q8IDEVAI_DEV_ROOT=\"${Q8IDEVAI_WORKTREE_PATH:-$PWD}\" Q8IDEVAI_HOME=\"${Q8IDEVAI_WORKTREE_PATH:-$PWD}/.dev/q8idevai-home\" Q8IDEVAI_LISTEN=0.0.0.0:${Q8IDEVAI_SERVICE_DAEMON_PORT:-6768} Q8IDEVAI_DEV_DAEMON_ENDPOINT=localhost:${Q8IDEVAI_SERVICE_DAEMON_PORT:-6768} EXPO_PORT=${Q8IDEVAI_PORT:-} ./scripts/dev-app.sh"
    },
    "desktop": {
      "type": "service",
      "command": "Q8IDEVAI_DEV_MANAGED_HOME=1 Q8IDEVAI_DEV_ROOT=\"${Q8IDEVAI_WORKTREE_PATH:-$PWD}\" Q8IDEVAI_HOME=\"${Q8IDEVAI_WORKTREE_PATH:-$PWD}/.dev/q8idevai-home\" Q8IDEVAI_LISTEN=0.0.0.0:${Q8IDEVAI_SERVICE_DAEMON_PORT:-6768} Q8IDEVAI_DEV_DAEMON_ENDPOINT=localhost:${Q8IDEVAI_SERVICE_DAEMON_PORT:-6768} EXPO_PORT=${Q8IDEVAI_PORT:-} exec ./packages/desktop/scripts/dev.sh"
    },
    "ios-simulator": {
      "type": "service",
      "command": "Q8IDEVAI_DEV_MANAGED_HOME=1 Q8IDEVAI_DEV_ROOT=\"$PWD\" Q8IDEVAI_HOME=\"$PWD/.dev/q8idevai-home\" Q8IDEVAI_LISTEN=0.0.0.0:${Q8IDEVAI_SERVICE_DAEMON_PORT} Q8IDEVAI_DEV_DAEMON_ENDPOINT=localhost:${Q8IDEVAI_SERVICE_DAEMON_PORT} ./scripts/q8idevai-ios-simulator-service.sh"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
